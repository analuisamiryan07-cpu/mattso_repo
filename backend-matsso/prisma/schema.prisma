generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  schemas    = ["public", "matsso", "lms"]
}

// ==========================================
// SCHEMA: MATSSO (Catálogo Institucional)
// ==========================================

model Familia {
  id_familia    Int       @id @default(autoincrement())
  nombre        String    @unique @db.VarChar(120)
  descripcion   String?   @db.Text
  activo        Boolean   @default(true)
  created_at    DateTime  @default(now()) @db.Timestamptz
  updated_at    DateTime  @default(now()) @db.Timestamptz

  sectores      Sector[]
  certificaciones Certificacion[]
  clientes      Cliente[]

  @@schema("matsso")
  @@map("familia")
}

model Sector {
  id_sector     Int       @id @default(autoincrement())
  id_familia    Int
  nombre        String    @unique @db.VarChar(200)
  codigo_ciiu   String?   @db.VarChar(10)
  descripcion   String?   @db.Text
  activo        Boolean   @default(true)
  created_at    DateTime  @default(now()) @db.Timestamptz
  updated_at    DateTime  @default(now()) @db.Timestamptz

  familia       Familia   @relation(fields: [id_familia], references: [id_familia])
  certificaciones Certificacion[]
  clientes      Cliente[]

  @@schema("matsso")
  @@map("sector")
}

model Vigencia {
  id_vigencia   Int       @id @default(autoincrement())
  anos          Int       @unique @db.SmallInt
  etiqueta      String    @db.VarChar(20)
  activo        Boolean   @default(true)
  created_at    DateTime  @default(now()) @db.Timestamptz
  updated_at    DateTime  @default(now()) @db.Timestamptz

  certificaciones Certificacion[]

  @@schema("matsso")
  @@map("vigencia")
}

model Certificacion {
  id_certificacion Int      @id @default(autoincrement())
  codigo           String   @unique @db.VarChar(20)
  nombre           String   @unique @db.VarChar(300)
  descripcion      String   @db.Text
  id_vigencia      Int
  id_familia       Int
  id_sector        Int
  activo           Boolean  @default(true)
  created_at       DateTime @default(now()) @db.Timestamptz
  updated_at       DateTime @default(now()) @db.Timestamptz
  created_by       String   @default(dbgenerated("CURRENT_USER")) @db.VarChar(100)
  updated_by       String   @default(dbgenerated("CURRENT_USER")) @db.VarChar(100)

  vigencia         Vigencia @relation(fields: [id_vigencia], references: [id_vigencia])
  familia          Familia  @relation(fields: [id_familia], references: [id_familia])
  sector           Sector   @relation(fields: [id_sector], references: [id_sector])
  perfiles         PerfilDirigido[]
  requisitos       Requisito[]
  conocimientos    Conocimiento[]
  evaluaciones     Evaluacion[]
  competencias     Competencia[]
  habilidades      Habilidad[]
  productos        Producto[]

  @@schema("matsso")
  @@map("certificacion")
}

model PerfilDirigido {
  id_perfil        Int      @id @default(autoincrement())
  id_certificacion Int
  descripcion      String   @db.Text
  orden            Int      @default(1) @db.SmallInt
  activo           Boolean  @default(true)
  created_at       DateTime @default(now()) @db.Timestamptz
  updated_at       DateTime @default(now()) @db.Timestamptz

  certificacion    Certificacion @relation(fields: [id_certificacion], references: [id_certificacion], onDelete: Cascade)

  @@schema("matsso")
  @@map("perfil_dirigido")
}

model Requisito {
  id_requisito     Int      @id @default(autoincrement())
  id_certificacion Int
  tipo             String   @db.VarChar(50)
  descripcion      String   @db.Text
  orden            Int      @default(1) @db.SmallInt
  activo           Boolean  @default(true)
  created_at       DateTime @default(now()) @db.Timestamptz
  updated_at       DateTime @default(now()) @db.Timestamptz

  certificacion    Certificacion @relation(fields: [id_certificacion], references: [id_certificacion], onDelete: Cascade)

  @@schema("matsso")
  @@map("requisito")
}

model Conocimiento {
  id_conocimiento  Int      @id @default(autoincrement())
  id_certificacion Int
  descripcion      String   @db.Text
  orden            Int      @default(1) @db.SmallInt
  activo           Boolean  @default(true)
  created_at       DateTime @default(now()) @db.Timestamptz
  updated_at       DateTime @default(now()) @db.Timestamptz

  certificacion    Certificacion @relation(fields: [id_certificacion], references: [id_certificacion], onDelete: Cascade)

  @@schema("matsso")
  @@map("conocimiento")
}

model Evaluacion {
  id_evaluacion     Int      @id @default(autoincrement())
  id_certificacion  Int
  modalidad         String   @db.VarChar(20)
  descripcion       String   @db.Text
  porcentaje_minimo Decimal? @db.Decimal(5,2)
  porcentaje_max    Decimal? @db.Decimal(5,2)
  activo            Boolean  @default(true)
  created_at        DateTime @default(now()) @db.Timestamptz
  updated_at        DateTime @default(now()) @db.Timestamptz

  certificacion     Certificacion @relation(fields: [id_certificacion], references: [id_certificacion], onDelete: Cascade)

  @@schema("matsso")
  @@map("evaluacion")
  @@unique([id_certificacion, modalidad])
}

model Competencia {
  id_competencia   Int      @id @default(autoincrement())
  id_certificacion Int
  descripcion      String   @db.Text
  orden            Int      @default(1) @db.SmallInt
  activo           Boolean  @default(true)
  created_at       DateTime @default(now()) @db.Timestamptz
  updated_at       DateTime @default(now()) @db.Timestamptz

  certificacion    Certificacion @relation(fields: [id_certificacion], references: [id_certificacion], onDelete: Cascade)

  @@schema("matsso")
  @@map("competencia")
}

model Habilidad {
  id_habilidad     Int      @id @default(autoincrement())
  id_certificacion Int
  tipo             String   @db.VarChar(10)
  descripcion      String   @db.Text
  orden            Int      @default(1) @db.SmallInt
  activo           Boolean  @default(true)
  created_at       DateTime @default(now()) @db.Timestamptz
  updated_at       DateTime @default(now()) @db.Timestamptz

  certificacion    Certificacion @relation(fields: [id_certificacion], references: [id_certificacion], onDelete: Cascade)

  @@schema("matsso")
  @@map("habilidad")
}

// ==========================================
// SCHEMA: PUBLIC (E-Commerce y Operativa)
// ==========================================

model Cliente {
  id                  BigInt        @id @default(autoincrement())
  nombre              String        @db.VarChar(255)
  cedula              String        @unique @db.VarChar(15)
  telefono            String?       @db.VarChar(255)
  correo              String?       @db.VarChar(255)
  direccion           String?
  fecha               DateTime      @db.Date
  ciudad              String?       @db.VarChar(255)
  lugar               String?       @db.VarChar(255)
  esquema             String?       @db.VarChar(255)
  tipo_examen         String?       @db.VarChar(255)
  puntaje_teorico     String?       @db.VarChar(255)
  puntaje_practico    String?       @db.VarChar(255)
  id_familia          Int?
  id_sector           Int?
  created_at          DateTime?     @db.Timestamp(0)
  updated_at          DateTime?     @db.Timestamp(0)
  nombre_examinador   String?       @db.VarChar(255)
  cedula_examinador   String?       @db.VarChar(20)
  telefono_examinador String?       @db.VarChar(20)
  edad                Int?
  celular1            String?       @db.VarChar(20)
  cv_metadata         Json?
  
  usuarios_web        UsuarioWeb[]
  familia             Familia?      @relation(fields: [id_familia], references: [id_familia])
  sector              Sector?       @relation(fields: [id_sector], references: [id_sector])

  @@schema("public")
  @@map("clientes")
}

model UsuarioWeb {
  id                     BigInt    @id @default(autoincrement())
  cliente_id             BigInt?
  correo                 String    @unique @db.VarChar(255)
  password_hash          String    @db.VarChar(255)
  rol                    String    @default("ESTUDIANTE") @db.VarChar(50)
  activo                 Boolean?  @default(true)
  created_at             DateTime? @default(now()) @db.Timestamp(0)
  reset_token            String?   @db.VarChar(255)
  reset_token_expires_at DateTime? @db.Timestamp(0)

  cliente             Cliente?      @relation(fields: [cliente_id], references: [id])
  ordenes             Orden[]
  enrollments         Enrollment[]
  submissions_gradas  ManualGrade[] @relation("SubmissionsGradedBy")
  cursos_dictados     Course[]      @relation("CoursesTaught")
  access_grants       AccessGrant[]

  @@schema("public")
  @@map("usuarios_web")
}

model Producto {
  id                 BigInt    @id @default(autoincrement())
  tipo               String    @db.VarChar(50) // CAPACITACION o CERTIFICACION
  titulo             String    @db.VarChar(255)
  descripcion        String?
  descripcion_larga  String?   @db.Text
  precio             Decimal   @db.Decimal(10, 2)
  horas              Int?
  modalidad          String?   @db.VarChar(100)
  fecha              String?   @db.VarChar(100)
  horario            String?   @db.VarChar(100)
  imagen_url         String?   @db.VarChar(255)
  activo             Boolean?  @default(true)
  destacado          Boolean   @default(false)
  id_certificacion   Int?
  created_at         DateTime? @default(now()) @db.Timestamp(0)
  
  certificacion    Certificacion? @relation(fields: [id_certificacion], references: [id_certificacion])
  esquemas         EsquemaCertificacion[]
  orden_items      OrdenItem[]
  curso            Course?

  @@schema("public")
  @@map("productos")
}

model EsquemaCertificacion {
  id                 BigInt   @id @default(autoincrement())
  producto_id        BigInt
  perfil_profesional String   @db.VarChar(255)
  nombre_esquema     String   @db.VarChar(255)

  producto           Producto @relation(fields: [producto_id], references: [id], onDelete: Cascade)

  @@schema("public")
  @@map("esquemas_certificacion")
}

model Orden {
  id              BigInt    @id @default(autoincrement())
  usuario_id      BigInt
  total           Decimal   @db.Decimal(10, 2)
  estado          String    @default("PENDIENTE") @db.VarChar(50)
  fecha_orden     DateTime? @default(now()) @db.Timestamp(0)
  metodo_pago     String?   @db.VarChar(100)
  comprobante_url String?   @db.VarChar(255)
  // Solo para órdenes creadas a mano desde el sistema interno (venta por
  // teléfono, sin pasar por la página web): reemplaza al comprobante, que
  // esas órdenes no tienen. `total` se sigue calculando igual que en una
  // compra web (precio de catálogo + IVA) — este campo es el registro de
  // cuánto se cobró en la práctica, para conciliar, no lo que decide el total.
  monto_pagado_manual Decimal? @db.Decimal(10, 2)

  usuario      UsuarioWeb  @relation(fields: [usuario_id], references: [id])
  items        OrdenItem[]
  pagos        Pago[]

  @@schema("public")
  @@map("ordenes")
}

model OrdenItem {
  id              BigInt   @id @default(autoincrement())
  orden_id        BigInt
  producto_id     BigInt
  precio_unitario Decimal  @db.Decimal(10, 2)
  cantidad        Int      @default(1)

  orden           Orden        @relation(fields: [orden_id], references: [id], onDelete: Cascade)
  producto        Producto     @relation(fields: [producto_id], references: [id])
  enrollments     Enrollment[]
  // Lista, no un solo registro: una compra revocada sin canjear libera el
  // cupo para generar otra clave (ver comentario en AccessGrant) — puede
  // haber más de una fila en el tiempo, aunque como mucho una esté vigente.
  access_grants   AccessGrant[]

  @@schema("public")
  @@map("orden_items")
}

model Pago {
  id              BigInt    @id @default(autoincrement())
  orden_id        BigInt
  paypal_order_id String    @unique @db.VarChar(120)
  capture_id      String?   @unique @db.VarChar(120)
  monto           Decimal   @db.Decimal(12, 2)
  moneda          String    @default("USD") @db.VarChar(3)
  estado          String    @default("CREADO") @db.VarChar(40)
  correo_pagador  String?   @db.VarChar(255)
  respuesta_raw   Json?
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @default(now()) @db.Timestamptz
  paid_at         DateTime? @db.Timestamptz

  orden           Orden     @relation(fields: [orden_id], references: [id])

  @@schema("public")
  @@map("pagos")
}

model WebhookEvent {
  id            BigInt    @id @default(autoincrement())
  proveedor     String    @default("PAYPAL") @db.VarChar(30)
  evento_id     String    @db.VarChar(150)
  tipo_evento   String    @db.VarChar(120)
  payload       Json
  procesado     Boolean   @default(false)
  recibido_at   DateTime  @default(now()) @db.Timestamptz
  procesado_at  DateTime? @db.Timestamptz

  @@unique([proveedor, evento_id])
  @@schema("public")
  @@map("webhook_events")
}

model QrCertificado {
  id               BigInt    @id @default(autoincrement())
  codigo           String    @unique @db.VarChar(12)
  nombres          String    @db.VarChar(255)
  certificado      String    @db.VarChar(255)
  fecha_emision    String    @db.VarChar(50)
  fecha_expiracion String    @db.VarChar(50)
  estado           String    @default("VIGENTE") @db.VarChar(20)
  created_at       DateTime  @default(now()) @db.Timestamptz

  @@schema("public")
  @@map("qr_certificados")
}

// ==========================================
// SCHEMA: LMS (Cursos, progreso y evaluación)
// ==========================================
// Ver Moodles/arquitectura_lms_nube.md. Todas las PK son UUID (no requieren
// ofuscación con id-hasher como las tablas de public/matsso, que usan BigInt
// autoincremental).
//
// Nota de diseño abierta: un orden_item puede representar varios cupos
// (cantidad > 1, compra corporativa). Por eso Enrollment.orden_item_id NO es
// único ni 1:1 — un mismo orden_item puede generar varios Enrollment (uno por
// persona inscrita). La idempotencia real está en @@unique([usuario_id,
// course_id]): un usuario no puede quedar inscrito dos veces en el mismo
// curso. Cómo se capturan/resuelven las identidades de los cupos adicionales
// (formulario del comprador, invitación, alta manual del admin) es lógica de
// aplicación del webhook/endpoint de inscripción, no del schema.

enum DeliveryMode {
  TRADICIONAL
  ASINCRONO_VOD

  @@schema("lms")
}

enum ContentItemType {
  VIDEO
  ASSIGNMENT
  QUIZ
  DOCUMENT

  @@schema("lms")
}

enum EnrollmentSource {
  ECOMMERCE
  MANUAL
  ADMIN

  @@schema("lms")
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  SUSPENDED
  CANCELLED

  @@schema("lms")
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED

  @@schema("lms")
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE

  @@schema("lms")
}

enum QuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED

  @@schema("lms")
}

model Course {
  id                  String       @id @default(uuid()) @db.Uuid
  producto_id         BigInt?      @unique
  // Dueño del curso. NULL = creado antes de existir este campo, o por un
  // profesor que luego fue desactivado sin reasignar sus cursos — se decide
  // qué hacer con esos casos cuando aparezcan, no se fuerza un valor ahora.
  profesor_usuario_id BigInt?
  titulo              String       @db.VarChar(255)
  descripcion         String?      @db.Text
  // Un curso puede tener contenido para las dos modalidades a la vez —
  // reemplaza al antiguo campo único `delivery_mode` (ver DECISIONES.md,
  // "curso dual"). Cada Module ahora carga su propio DeliveryMode; estas dos
  // banderas son lo que decide qué secciones se ofrecen/venden y qué le
  // permite ver una AccessGrant una vez canjeada. Al menos una debe ser true
  // (se valida en el service, no aquí: Prisma no hace CHECK entre columnas).
  modo_moodle   Boolean  @default(false)
  modo_coursera Boolean  @default(false)
  // Nombre de la carpeta en Cloudinary (Cursos/{cloudinary_folder}/...). Se
  // calcula una sola vez al crear el curso, a partir del título, con
  // desambiguación si ya existe otro curso con el mismo nombre limpio — ver
  // AdminCoursesService.buildCloudinaryFolder(). No se recalcula si el título
  // cambia después (las imágenes ya subidas seguirían ahí).
  cloudinary_folder String?      @unique @db.VarChar(255)
  // Meses de acceso desde que el ESTUDIANTE canjea la clave (no desde la
  // compra). Se copia a AccessGrant.duracion_meses al generar cada clave, así
  // que cambiar esto después no afecta claves ya generadas.
  duracion_meses    Int?
  is_active           Boolean      @default(true)
  created_at          DateTime     @default(now()) @db.Timestamptz
  updated_at          DateTime     @default(now()) @updatedAt @db.Timestamptz

  producto      Producto?     @relation(fields: [producto_id], references: [id])
  profesor      UsuarioWeb?   @relation("CoursesTaught", fields: [profesor_usuario_id], references: [id])
  modules       Module[]
  enrollments   Enrollment[]
  access_grants AccessGrant[]

  @@map("courses")
  @@schema("lms")
}

model Module {
  id             String       @id @default(uuid()) @db.Uuid
  course_id      String       @db.Uuid
  // A qué árbol de contenido pertenece este módulo dentro del curso — ver el
  // comentario de Course.modo_moodle/modo_coursera. El desbloqueo secuencial
  // (courses.service.ts) se calcula por separado dentro de cada modalidad.
  delivery_mode  DeliveryMode
  titulo         String       @db.VarChar(255)
  sequence_order Int          @db.SmallInt
  is_active      Boolean      @default(true)
  created_at     DateTime     @default(now()) @db.Timestamptz
  updated_at     DateTime     @default(now()) @updatedAt @db.Timestamptz

  course        Course        @relation(fields: [course_id], references: [id], onDelete: Cascade)
  content_items ContentItem[]

  // El orden es independiente por modalidad — un mismo curso puede tener
  // módulo 1 de Moodle Y módulo 1 de Coursera al mismo tiempo.
  @@unique([course_id, delivery_mode, sequence_order])
  @@map("modules")
  @@schema("lms")
}

model ContentItem {
  id                      String          @id @default(uuid()) @db.Uuid
  module_id               String          @db.Uuid
  item_type               ContentItemType
  titulo                  String          @db.VarChar(255)
  sequence_order          Int             @db.SmallInt
  cloudinary_public_id    String?         @db.VarChar(255)
  cloudinary_url          String?         @db.VarChar(500)
  video_duration_seconds  Int?
  assignment_instructions String?         @db.Text
  is_active               Boolean         @default(true)
  created_at              DateTime        @default(now()) @db.Timestamptz
  updated_at              DateTime        @default(now()) @updatedAt @db.Timestamptz

  module              Module              @relation(fields: [module_id], references: [id], onDelete: Cascade)
  quiz                Quiz?
  student_progress    StudentProgress[]
  student_submissions StudentSubmission[]

  @@unique([module_id, sequence_order])
  @@map("content_items")
  @@schema("lms")
}

model Enrollment {
  id            String           @id @default(uuid()) @db.Uuid
  usuario_id    BigInt
  course_id     String           @db.Uuid
  orden_item_id BigInt?
  source        EnrollmentSource @default(ECOMMERCE)
  status        EnrollmentStatus @default(ACTIVE)
  enrolled_at   DateTime         @default(now()) @db.Timestamptz
  completed_at  DateTime?        @db.Timestamptz

  usuario       UsuarioWeb          @relation(fields: [usuario_id], references: [id])
  course        Course              @relation(fields: [course_id], references: [id])
  orden_item    OrdenItem?          @relation(fields: [orden_item_id], references: [id])
  progress      StudentProgress[]
  submissions   StudentSubmission[]
  quiz_attempts QuizAttempt[]

  @@unique([usuario_id, course_id])
  @@index([orden_item_id])
  @@map("enrollments")
  @@schema("lms")
}

model StudentProgress {
  id                    String         @id @default(uuid()) @db.Uuid
  enrollment_id         String         @db.Uuid
  content_item_id       String         @db.Uuid
  status                ProgressStatus @default(NOT_STARTED)
  video_seconds_reached Decimal?       @db.Decimal(10, 2)
  completed_at          DateTime?      @db.Timestamptz
  updated_at            DateTime       @default(now()) @updatedAt @db.Timestamptz

  enrollment   Enrollment  @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)
  content_item ContentItem @relation(fields: [content_item_id], references: [id], onDelete: Cascade)

  @@unique([enrollment_id, content_item_id])
  @@map("student_progress")
  @@schema("lms")
}

model StudentSubmission {
  id              String   @id @default(uuid()) @db.Uuid
  enrollment_id   String   @db.Uuid
  content_item_id String   @db.Uuid
  attempt_number  Int      @default(1) @db.SmallInt
  file_url        String   @db.VarChar(500)
  comentario      String?  @db.Text
  submitted_at    DateTime @default(now()) @db.Timestamptz

  enrollment   Enrollment   @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)
  content_item ContentItem  @relation(fields: [content_item_id], references: [id], onDelete: Cascade)
  grade        ManualGrade?

  @@unique([enrollment_id, content_item_id, attempt_number])
  @@map("student_submissions")
  @@schema("lms")
}

model ManualGrade {
  id                   String   @id @default(uuid()) @db.Uuid
  submission_id        String   @unique @db.Uuid
  graded_by_usuario_id BigInt
  score                Decimal  @db.Decimal(5, 2)
  feedback             String?  @db.Text
  graded_at            DateTime @default(now()) @db.Timestamptz

  submission StudentSubmission @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  graded_by  UsuarioWeb        @relation("SubmissionsGradedBy", fields: [graded_by_usuario_id], references: [id])

  @@map("manual_grades")
  @@schema("lms")
}

model Quiz {
  id                 String   @id @default(uuid()) @db.Uuid
  content_item_id    String   @unique @db.Uuid
  titulo             String   @db.VarChar(255)
  passing_score      Decimal  @default(70) @db.Decimal(5, 2)
  max_attempts       Int?     @db.SmallInt
  time_limit_seconds Int?
  created_at         DateTime @default(now()) @db.Timestamptz
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamptz

  content_item ContentItem    @relation(fields: [content_item_id], references: [id], onDelete: Cascade)
  questions    QuizQuestion[]
  attempts     QuizAttempt[]

  @@map("quizzes")
  @@schema("lms")
}

model QuizQuestion {
  id             String       @id @default(uuid()) @db.Uuid
  quiz_id        String       @db.Uuid
  enunciado      String       @db.Text
  question_type  QuestionType @default(SINGLE_CHOICE)
  sequence_order Int          @db.SmallInt
  points         Decimal      @default(1) @db.Decimal(5, 2)

  quiz    Quiz                @relation(fields: [quiz_id], references: [id], onDelete: Cascade)
  options QuizOption[]
  answers QuizAttemptAnswer[]

  @@unique([quiz_id, sequence_order])
  @@map("quiz_questions")
  @@schema("lms")
}

model QuizOption {
  id             String  @id @default(uuid()) @db.Uuid
  question_id    String  @db.Uuid
  texto          String  @db.Text
  is_correct     Boolean @default(false)
  sequence_order Int     @db.SmallInt

  question QuizQuestion              @relation(fields: [question_id], references: [id], onDelete: Cascade)
  answers  QuizAttemptAnswerOption[]

  @@unique([question_id, sequence_order])
  @@map("quiz_options")
  @@schema("lms")
}

model QuizAttempt {
  id             String            @id @default(uuid()) @db.Uuid
  enrollment_id  String            @db.Uuid
  quiz_id        String            @db.Uuid
  attempt_number Int               @db.SmallInt
  status         QuizAttemptStatus @default(IN_PROGRESS)
  score          Decimal?          @db.Decimal(5, 2)
  passed         Boolean?
  started_at     DateTime          @default(now()) @db.Timestamptz
  submitted_at   DateTime?         @db.Timestamptz

  enrollment Enrollment          @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)
  quiz       Quiz                @relation(fields: [quiz_id], references: [id])
  answers    QuizAttemptAnswer[]

  @@unique([enrollment_id, quiz_id, attempt_number])
  @@map("quiz_attempts")
  @@schema("lms")
}

model QuizAttemptAnswer {
  id          String @id @default(uuid()) @db.Uuid
  attempt_id  String @db.Uuid
  question_id String @db.Uuid

  attempt          QuizAttempt               @relation(fields: [attempt_id], references: [id], onDelete: Cascade)
  question         QuizQuestion              @relation(fields: [question_id], references: [id])
  selected_options QuizAttemptAnswerOption[]

  @@unique([attempt_id, question_id])
  @@map("quiz_attempt_answers")
  @@schema("lms")
}

model QuizAttemptAnswerOption {
  answer_id String @db.Uuid
  option_id String @db.Uuid

  answer QuizAttemptAnswer @relation(fields: [answer_id], references: [id], onDelete: Cascade)
  option QuizOption        @relation(fields: [option_id], references: [id])

  @@id([answer_id, option_id])
  @@map("quiz_attempt_answer_options")
  @@schema("lms")
}

// Segundo factor de acceso al Aula Virtual (Moodles/lms/docs/REQUISITOS_SISTEMA_INTERNO.md
// §4). El sistema interno la genera vía POST /api/lms/admin/access-codes; el
// estudiante la ingresa una vez tras iniciar sesión, antes de ver sus cursos.
// Reemplaza a AccessCode (código de 6 dígitos, uno por usuario, desbloqueaba
// todo para siempre). Ahora es una clave por CADA compra de curso: el sistema
// interno la genera como JWT (nombre del curso, duración, permisos
// moodle/coursera — ver access-grants/jwt.util.ts) y se la entrega a la
// persona por fuera de la nube (correo/WhatsApp). Esta fila es el registro
// del lado del servidor: guarda el `jti` del JWT (para poder invalidarlo sin
// tener que decodificarlo) y el estado real del canje — el JWT en sí nunca
// se guarda completo aquí.
//
// Como mucho UNA fila sin revocar por cada OrdenItem — es el candado de
// "esta compra ya se usó" que pide la arquitectura (se aparta al GENERAR,
// no al canjear). No es un @unique de columna porque revocar una clave sin
// canjear debe liberar el cupo (§2.4 del contrato: "se generó por error...
// hay que anularla antes de generar otra") — la unicidad real es "por
// OrdenItem, a lo sumo una fila con revoked_at IS NULL", que se garantiza
// con un índice único parcial en la migración (ver 12_lms_cursos_dual.sql)
// y se revisa también en el service antes de crear.
model AccessGrant {
  id             String    @id @default(uuid()) @db.Uuid
  usuario_id     BigInt
  course_id      String    @db.Uuid
  orden_item_id  BigInt
  // Copiado de Course.duracion_meses en el momento de generar — si el curso
  // cambia su duración después, esta clave ya generada no se ve afectada.
  duracion_meses Int
  // El `jti` (JWT ID) que va dentro del token firmado. Es lo que se compara
  // al canjear — permite invalidar la clave sin tener que verificar la firma
  // primero, y sin guardar el JWT completo (que podría filtrarse en un log).
  jwt_id       String    @unique @db.Uuid
  generado_at  DateTime  @default(now()) @db.Timestamptz
  // Actor M2M que la generó (ej. "laravel-admin:12"), igual que en el resto
  // del LMS — nunca un id que mande el navegador.
  generado_por String    @db.VarChar(100)
  // NULL hasta que el estudiante la canjea con éxito. expires_at se calcula
  // recién en ese momento (redeemed_at + duracion_meses) — antes de canjear
  // la clave no "gasta" tiempo de nadie.
  redeemed_at  DateTime? @db.Timestamptz
  expires_at   DateTime? @db.Timestamptz
  // Para "revocar clave sin usar" (§2.4 del contrato). Solo se puede revocar
  // si redeemed_at es NULL — una clave ya canjeada no se revoca (el acceso
  // ya se le dio, y con qué se define su vencimiento). Al revocar SÍ se
  // libera el cupo de esta compra: se puede generar una clave nueva para el
  // mismo orden_item_id (ver AccessGrantsService.revocar/generar).
  revoked_at   DateTime? @db.Timestamptz

  usuario    UsuarioWeb @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  course     Course     @relation(fields: [course_id], references: [id])
  orden_item OrdenItem  @relation(fields: [orden_item_id], references: [id])

  @@index([usuario_id])
  @@index([orden_item_id])
  @@map("access_grants")
  @@schema("lms")
}
